# PYNQ-Z2 manual v1.1 Table13/14 + Xilinx/PYNQ v3.1.2 base.xdc.
# PMODA shares RPi header: do not connect another device to the shared nets.
set_property -dict {PACKAGE_PIN Y18 IOSTANDARD LVCMOS33 DRIVE 8 SLEW SLOW} [get_ports u1_s1]
set_property -dict {PACKAGE_PIN Y19 IOSTANDARD LVCMOS33 DRIVE 8 SLEW SLOW} [get_ports u1_s2]
set_property -dict {PACKAGE_PIN Y16 IOSTANDARD LVCMOS33 DRIVE 8 SLEW SLOW} [get_ports u1_s3]
set_property -dict {PACKAGE_PIN Y17 IOSTANDARD LVCMOS33 DRIVE 8 SLEW SLOW} [get_ports u1_s4]
set_property -dict {PACKAGE_PIN U18 IOSTANDARD LVCMOS33 DRIVE 8 SLEW SLOW} [get_ports u2_s1]
set_property -dict {PACKAGE_PIN U19 IOSTANDARD LVCMOS33 DRIVE 8 SLEW SLOW} [get_ports u2_s2]
set_property -dict {PACKAGE_PIN W18 IOSTANDARD LVCMOS33 DRIVE 8 SLEW SLOW} [get_ports u2_s3]
set_property -dict {PACKAGE_PIN W19 IOSTANDARD LVCMOS33 DRIVE 8 SLEW SLOW} [get_ports u2_s4]
set_property -dict {PACKAGE_PIN W14 IOSTANDARD LVCMOS33 DRIVE 8 SLEW SLOW} [get_ports u3_s1]
set_property -dict {PACKAGE_PIN Y14 IOSTANDARD LVCMOS33 DRIVE 8 SLEW SLOW} [get_ports u3_s2]
set_property -dict {PACKAGE_PIN T11 IOSTANDARD LVCMOS33 DRIVE 8 SLEW SLOW} [get_ports u3_s3]
set_property -dict {PACKAGE_PIN T10 IOSTANDARD LVCMOS33 DRIVE 8 SLEW SLOW} [get_ports u3_s4]
set_property -dict {PACKAGE_PIN D19 IOSTANDARD LVCMOS33} [get_ports btn_start]
set_property -dict {PACKAGE_PIN D20 IOSTANDARD LVCMOS33} [get_ports btn_fault]
set_property -dict {PACKAGE_PIN L20 IOSTANDARD LVCMOS33} [get_ports btn_clear]
set_property -dict {PACKAGE_PIN R14 IOSTANDARD LVCMOS33 DRIVE 8 SLEW SLOW} [get_ports led_run]
set_property -dict {PACKAGE_PIN P14 IOSTANDARD LVCMOS33 DRIVE 8 SLEW SLOW} [get_ports led_fault]
set_property -dict {PACKAGE_PIN N16 IOSTANDARD LVCMOS33 DRIVE 8 SLEW SLOW} [get_ports led_ready]
set_property -dict {PACKAGE_PIN M14 IOSTANDARD LVCMOS33 DRIVE 8 SLEW SLOW} [get_ports led_startup]
set_false_path -from [get_ports btn_start] -to [get_pins {u_logic/u_controls/u_start_sync/sync_ff1_reg/D}]
set_false_path -from [get_ports btn_fault] -to [get_pins {u_logic/u_controls/u_fault_sync/sync_ff1_reg/D}]
set_false_path -from [get_ports btn_clear] -to [get_pins {u_logic/u_controls/u_clear_sync/sync_ff1_reg/D}]
# FCLK clock comes from PS IP. No invented external output timing.
